# Local tooling / sandbox
.env
.env.*
.venv/
venv/
.cache/
.tmp/
tmp/

# Claude Code: the skills symlink and shared settings are tracked; local settings
# (settings.local.json) and session state never are.
.claude/*
!.claude/settings.json
!.claude/skills
