{
    "id": "{{APP_ID}}.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "{{CRATE}}",
    "desktop-file-name-suffix": " (Devel)",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--env=RUST_LOG={{CRATE_IDENT}}=debug",
        "--env=RUST_BACKTRACE=1"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "build-args": [
            "--share=network"
        ],
        "test-args": [
            "--share=network"
        ],
        "env": {
            "RUSTFLAGS": "-C force-frame-pointers=yes"
        }
    },
    "modules": [
        {
            "name": "{{CRATE}}",
            "buildsystem": "meson",
            "builddir": true,
            "run-tests": true,
            "config-opts": [
                "-Dprofile=development"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
